@page "/"
@inject IJSRuntime JS

<style>
    html, body {
        margin: 0;
        padding: 0;
        overflow: hidden;
        height: 100%;
        width: 100%;
        background-color: black; 
    }

    canvas {
        display: block;
        width: 100vw;
        height: 100vh;
    }
</style>

<canvas id="solar-canvas"></canvas>

@* <p style="position: absolute; top: 10px; left: 10px; color: white;">
    @_lastClick
</p> *@

@code {
    DotNetObjectReference<Explorer>? _ref;
    IJSObjectReference? _module;
    string _lastClick = "Click the cube!";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "/js/solarInterop.js");

        _ref = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("init", "solar-canvas");
        await _module.InvokeVoidAsync("bind", _ref);
    }

    [JSInvokable]
    public void OnMeshClicked(string name)
    {
        _lastClick = $"You clicked: {name}";
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        _ref?.Dispose();
        if (_module is not null)
            await _module.DisposeAsync();
    }
}
